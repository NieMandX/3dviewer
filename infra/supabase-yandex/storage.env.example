# Add these values to the official self-hosted Supabase .env file.
# Never commit real access keys.
GLOBAL_S3_BUCKET=agr-viewer-supabase-prod
GLOBAL_S3_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_REGION=ru-central1
YC_STORAGE_ACCESS_KEY_ID=
YC_STORAGE_SECRET_ACCESS_KEY=

# Production endpoint. api.agr.vision is reserved for the voice API.
PROXY_DOMAIN=supabase.agr.vision
SUPABASE_PUBLIC_URL=https://supabase.agr.vision
API_EXTERNAL_URL=https://supabase.agr.vision/auth/v1
SITE_URL=https://niemandx.github.io/3dviewer/
ADDITIONAL_REDIRECT_URLS=https://niemandx.github.io/**,https://agr.vision/**,http://localhost:*/**,http://127.0.0.1:*/**

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=true
