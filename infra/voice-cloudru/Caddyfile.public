{
    admin off
    default_bind {$LPM_WEB_BIND:0.0.0.0}
    servers {
        protocols h1 h2
    }
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete access_token
                    delete apikey
                    delete token
                    delete key
                }
                request>headers>Authorization delete
                request>headers>Cookie delete
                request>headers>X-Forwarded-Uri delete
            }
        }
    }
}

{$LPM_VIEWER_SITE:agr.vision} {
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    header X-Viewer-Build {$LPM_VIEWER_BUILD}
    encode gzip zstd
    handle_path /_viewer/* {
        root * /srv/lpmview-viewer/.releases
        @release_asset file
        header @release_asset Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/lpmview-viewer/.releases/{$LPM_VIEWER_BUILD}
        header Cache-Control no-cache
        file_server
    }
}

{$LPM_WWW_SITE:www.agr.vision} {
    redir https://agr.vision{uri} permanent
}

{$LPM_BACKEND_SITE:supabase.agr.vision} {
    @admin path /auth/v1/admin /auth/v1/admin/*
    handle @admin {
        respond "Not found" 404
    }
    @api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/*
    handle @api {
        reverse_proxy https://10.0.0.5:8443 {
            transport http {
                tls_trust_pool file /etc/lpmview-ca/backend-root.crt
            }
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }
    handle {
        respond "Not found" 404
    }
}

{$LPM_SERVICES_SITE:voice-api.agr.vision} {
    handle_path /model-check/* {
        reverse_proxy 127.0.0.1:8081 {
            header_up X-Lpmview-Client-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }
    @gis path /v1/2gis/* /v1/admin/2gis
    handle @gis {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /v1/token {
        respond "Voice is not enabled on this deployment" 503
    }
    handle {
        respond "Not found" 404
    }
}
