{
    admin off
    auto_https off
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete access_token
                }
                request>headers>X-Forwarded-Uri delete
                request>headers>Authorization delete
            }
        }
    }
}

http://:8090 {
    @private path /internal /internal/* /twirp /twirp/*
    handle @private {
        respond "Not found" 404
    }
    @rtc path /rtc /rtc/*
    handle @rtc {
        forward_auth voice-api:8080 {
            uri /internal/voice/admit
        }
        reverse_proxy livekit:7880
    }
    # Keep application entrypoints closed until full browser/media acceptance.
    handle /v1/token {
        respond "Voice authentication is not ready for public access" 503
    }
    handle /model-check* {
        respond "Checker backend is not configured" 503
    }
    handle {
        reverse_proxy voice-api:8080
    }
}
