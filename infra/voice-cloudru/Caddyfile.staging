{
    admin off
    auto_https off
}

http://:8090 {
    @rtc path /rtc /rtc/* /twirp/*
    handle @rtc {
        reverse_proxy livekit:7880
    }
    # The legacy token API has no room-membership check. Do not publish it.
    handle /v1/token {
        respond "Voice authentication is not ready for public access" 503
    }
    handle /model-check* {
        respond "Checker backend is not configured" 503
    }
    handle {
        reverse_proxy voice-api:8080
    }
}
